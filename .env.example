# Copy this file to .env and fill in your API keys.
# The .env file is loaded automatically by the config loader.

# NaN cluster (required) — https://nan.builders
NAN_API_KEY=sk-your-nan-key-here

# Semantic Scholar (optional but recommended for higher rate limits)
S2_API_KEY=

# OpenAlex (required if using OpenAlex provider)
OPENALEX_API_KEY=

# PubMed (optional, for higher rate limits — 10 req/s vs 3 req/s)
PUBMED_API_KEY=

# PubMed polite contact email
PUBMED_EMAIL=research@example.com
