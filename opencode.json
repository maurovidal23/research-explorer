{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN",
      "options": {
        "baseURL": "https://api.nan.builders/v1"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "family": "deepseek",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "status": "active"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "status": "active"
        },
        "mimo-v2.5": {
          "name": "MiMo V2.5",
          "family": "mimo",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "audio"],
            "output": ["text"]
          },
          "status": "active"
        },
        "glm5.2": {
          "name": "GLM 5.2",
          "family": "glm",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 200000,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "status": "active"
        },
        "glm5.3-flash": {
          "name": "GLM 5.3 Flash",
          "family": "glm",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 200000,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "status": "active"
        },
        "gemma4": {
          "name": "Gemma 4",
          "family": "gemma",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "status": "active"
        },
        "qwen3.6": {
          "name": "Qwen 3.6",
          "family": "qwen",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "status": "active"
        },
        "qwen3-embedding": {
          "name": "Qwen3 Embedding",
          "family": "qwen",
          "modalities": {
            "input": ["text"]
          },
          "status": "active"
        },
        "kokoro": {
          "name": "Kokoro v1.0",
          "family": "kokoro",
          "modalities": {
            "input": ["text"],
            "output": ["audio"]
          },
          "status": "active"
        },
        "whisper": {
          "name": "Whisper large-v3",
          "family": "whisper",
          "attachment": true,
          "modalities": {
            "input": ["audio"],
            "output": ["text"]
          },
          "status": "active"
        }
      }
    }
  },
  "model": "nan/mimo-v2.5",
  "small_model": "nan/deepseek-v4-flash",
  "agent": {
    "build": {
      "model": "nan/mimo-v2.5"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 50000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "*.parquet",
      "*.csv",
      "*.xlsx",
      "*.pdf",
      "data/raw/**",
      "data/html/**",
      "logs/**",
      ".pytest_cache/**"
    ]
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "mcp": {
    "kindly-web-search": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/Shelpuk-AI-Technology-Consulting/kindly-web-search-mcp-server", "kindly-web-search-mcp-server", "start-mcp-server"],
      "enabled": true,
      "env": {
        "SEARXNG_BASE_URL": "http://localhost:8080"
      }
    }
  }
}
